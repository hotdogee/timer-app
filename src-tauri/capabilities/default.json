{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: the whole app, the app's commands, and the desktop plugins it drives (notifications, global hotkeys, launch at login, updates, opening the sign-in page and links in the browser).",
  "windows": ["main"],
  "platforms": ["windows", "macOS", "linux"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:event:default",
    "notification:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "autostart:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://localhost:5173/device*" },
        { "url": "http://localhost:8787/device*" },
        { "url": "https://**" }
      ]
    },
    "allow-accent-color",
    "allow-set-running",
    "allow-set-close-behavior",
    "allow-open-mini",
    "allow-close-mini",
    "allow-set-mini-always-on-top",
    "allow-set-tray-labels",
    "allow-quote-launch-entry",
    "allow-updater-configured"
  ]
}
